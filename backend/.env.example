# Resume Crafter Environment Variables

# Application
ENVIRONMENT=
DEBUG=

# Database
DATABASE_URL=

# Redis
REDIS_URL=

# ChromaDB
CHROMA_HOST=
CHROMA_PORT=
CHROMA_COLLECTION=

# JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=

# LLM Provider Configuration
# Options: "ollama" (local), "groq" (cloud), "openrouter" (cloud - many models)
LLM_PROVIDER=

# Ollama settings (local)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Groq settings (cloud - fast, free tier)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=

# OpenRouter settings (cloud - access to many models)
# Note: If you have Zero Data Retention enabled, use paid models or disable ZDR at:
# https://openrouter.ai/settings/privacy
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=

# GitHub API (for project enrichment)
GITHUB_TOKEN=your_github_token

# Embedding Model
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# File Upload
MAX_UPLOAD_SIZE_MB=
UPLOAD_DIR=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=

# CORS (comma-separated origins)
CORS_ORIGINS_STR=

# =
# AUTOMATION INTEGRATIONS
# =

# LinkedIn Scraper
# Get li_at cookie from: Browser DevTools > Application > Cookies > linkedin.com
LINKEDIN_SESSION_COOKIE=your_linkedin_li_at_cookie

# Email Integration (for outreach drafts)
# Using SMTP for direct email sending instead of Gmail MCP OAuth
SMTP_HOST=
SMTP_PORT=
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=

# Scheduling Integration
# Cal.com or Calendly link for meeting bookings
SCHEDULING_PROVIDER=
SCHEDULING_LINK=https://cal.com/yourname/30min
CALCOM_API_KEY=

# Automation Rate Limits
MAX_APPLICATIONS_PER_DAY=
MIN_APPLICATION_DELAY_SECONDS=
MAX_LINKEDIN_REQUESTS_PER_HOUR=
